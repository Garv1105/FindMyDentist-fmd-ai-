APP_ENV=local
CLINIC_OS_URL=http://localhost:3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fmd
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
# RDS: set DB_SSLROOTCERT=certs/rds-global-bundle.pem (verifies cert + hostname; overrides DB_SSLMODE)
DB_SSLROOTCERT=
# Optional tuning (defaults shown). Per process: workers × (POOL_SIZE + MAX_OVERFLOW) must stay under RDS max_connections.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=15000

# 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value-of-32-chars-or-more
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Optional: also allow origins matching this pattern (Vercel previews), e.g.
# ALLOWED_ORIGIN_REGEX=https://find-my-dentist-[a-z0-9-]+-garv-0cc1\.vercel\.app

CORS_ORIGINS=["http://localhost:3000"]
# Local only: http://localhost isn't HTTPS. Defaults to true when unset, so production stays safe.
COOKIE_SECURE=false
# Prod: share the session between fmd.in and clinic.fmd.in
# COOKIE_DOMAIN=.fmd.in

# OTPs, resend cooldowns and rate limits. Local: `docker compose up -d` in the repo root.
# Prod: ElastiCache (ap-south-1) with TLS, e.g. rediss://master.fmd-cache.xxxxxx.aps1.cache.amazonaws.com:6379/0
REDIS_URL=redis://localhost:6379/0

# SMS: "log" prints OTPs in this terminal. "msg91" sends via MSG91 Flow API with DLT-approved templates.
SMS_PROVIDER=log
# MSG91_AUTH_KEY=
# Template IDs from the MSG91 panel. The otp template must use the variable ##otp##; the others ##name##.
# MSG91_TEMPLATES={"otp":"...","password_changed":"...","account_locked":"..."}

# Email: "log" prints emails here. "ses" sends via Amazon SES (sesv2) using the standard AWS
# credential chain (IAM role on ECS, or AWS_PROFILE / AWS_ACCESS_KEY_ID locally).
EMAIL_PROVIDER=log
EMAIL_FROM=FMD <no-reply@fmd.in>
AWS_REGION=ap-south-1

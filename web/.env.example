# Copy to .env.local for `next dev`. Vercel: set these in the project's Environment Variables.

# FastAPI (../server). /api/v1/* is proxied there (next.config.ts) and src/proxy.ts renews sessions through it.
API_URL=http://localhost:8000
# Must equal the FastAPI SECRET_KEY: this app checks FastAPI's sign-in cookie itself (src/server/auth.ts)
FMD_API_JWT_SECRET=

# PostgreSQL. This app's data lives in its own schema (FMD_DB_SCHEMA, default "app"; created and migrated on first
# use), so it can share FastAPI's database. The waitlist (app/api/waitlist) writes public.waitlist in the same database.
# Local: postgres://postgres:<password>@localhost:5432/fmd_app
DATABASE_URL=
# FMD_DB_SCHEMA=app
# Connections per server instance (serverless: keep small, or put RDS Proxy / PgBouncer in front)
# DATABASE_POOL_MAX=5
# 1 = verify the database's TLS certificate (needs its CA in the system store); remote connections always use TLS
# DATABASE_SSL_VERIFY=

# Tests (npm test) use their own database: schema app_test, rebuilt on each run
# FMD_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fmd_app_test

# Files (records, patient files, ticket attachments). Unset: saved under .data/objects (development only).
# A private bucket; files are only ever served through this app. Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# (or a role). S3_ENDPOINT for an S3-compatible store.
S3_BUCKET=
# S3_PREFIX=objects/
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Signs record download links (required in production)
FMD_SIGNING_SECRET=

# Waitlist confirmation email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# FMD staff accounts: comma-separated verified emails that get staff roles when they first sign in
FMD_OPS_EMAILS=
FMD_ADMIN_EMAILS=
FMD_ACCOUNTANT_EMAILS=

# Copy to .env.local and fill in what you need. Every value is optional for local development: the app runs on
# sample data and a local SQLite file without any of them. Never commit real values.

# --- Data ---------------------------------------------------------------------------------------------------------
# Local SQLite file for the development API (default: web/.data/fmd.db; on Vercel: /tmp/fmd.db).
FMD_DB=
# Seed demo data into the local database (set to 0 to start empty).
FMD_SEED_DEMO=
# Postgres connection string, for the parts already moved to Postgres.
DATABASE_URL=
# Where /api/v1/* is proxied to (the FastAPI service). Default: http://localhost:8000
FMD_API_URL=

# --- Staff roles (comma-separated email addresses) -----------------------------------------------------------------
FMD_ADMIN_EMAILS=
FMD_OPS_EMAILS=
FMD_ACCOUNTANT_EMAILS=

# --- Email (waitlist and FMD Edge enquiries) -------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

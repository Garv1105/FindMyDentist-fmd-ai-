# Copy to .env.local for `next dev`. Vercel: set these in the project's Environment Variables.

# FastAPI (../server). /api/v1/* is proxied there (next.config.ts) and src/proxy.ts renews sessions through it.
API_URL=http://localhost:8000

# Waitlist (app/api/waitlist): Postgres connection string and SMTP for the confirmation email
DATABASE_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# This app's own data (until it moves to Postgres): SQLite file; default .data/fmd.db, /tmp/fmd.db on Vercel
# FMD_DB=
# Signs record download links (required in production)
FMD_SIGNING_SECRET=

# FMD staff accounts: comma-separated emails that get staff roles when they first sign in
FMD_OPS_EMAILS=
FMD_ADMIN_EMAILS=
FMD_ACCOUNTANT_EMAILS=
